# Local credential store (see credential_store/local_file_store.py) --
# never lives inside the repo, but guard against accidental placement.
.synevac/

# Real YOLO model validation milestone -- downloaded model weights and
# local validation videos are large binaries, never committed. See
# docs/architecture/human_detection.md for how to obtain them.
/weights/*.pt
/validation_media/

# Per-Candidate Predictive AI Data Foundation milestone -- generated
# campaign dataset/report (scripts/generate_predictive_dataset_campaign.py),
# regenerable from source, never committed. See
# docs/architecture/localized_predictive_ai_dataset.md for the campaign
# numbers this produced.
/data/predictive_dataset_campaign/

# Large-Scale Predictive Dataset Campaign & Validation milestone --
# generated 2000-scenario campaign dataset/report (scripts/
# run_predictive_dataset_campaign_v1.py), regenerable from source
# (deterministic master seed), never committed. See
# docs/architecture/predictive_dataset_campaign_v1.md for the numbers.
/data/predictive_dataset_campaign_v1/

# First Localized Predictive Congestion Model milestone -- exported
# model artifact/metadata/training report (scripts/
# train_localized_predictive_model_v1.py), regenerable from the
# (also-gitignored) predictive_dataset_campaign_v1 CSV, never committed.
# See docs/architecture/localized_predictive_model_v1.md for the numbers.
/data/localized_predictive_model_v1/

# Predictive Dataset V2 milestone -- generated multi-topology campaign
# dataset/report (scripts/run_predictive_dataset_campaign_v2.py),
# regenerable from source (deterministic master seed), never committed.
# See docs/architecture/predictive_dataset_campaign_v2.md for the numbers.
/data/predictive_dataset_campaign_v2/
